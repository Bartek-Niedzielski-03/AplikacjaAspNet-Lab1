@model List<Laboratorium1.Models.Album>

<h2>Lista albumów</h2>

<a class="btn btn-success mb-3" asp-action="Create">Dodaj nowy album</a>

@if (Model.Count > 0)
{
    <table class="table">
        <tr>
            <th>@Html.DisplayNameFor(m => m[0].Title)</th>
            <th>@Html.DisplayNameFor(m => m[0].Artist)</th>
            <th>@Html.DisplayNameFor(m => m[0].MusicType)</th>
            <th>Label</th>
            <th>Akcje</th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Artist</td>
                <td>@item.MusicType.GetDisplayName()</td>
                <td>@item.LabelTitle</td>
                <td>
                    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@item.Id">Edytuj</a>
                    <a class="btn btn-info" asp-action="Details" asp-route-id="@item.Id">Szczegóły</a>
                    <a class="btn btn-danger" asp-action="Delete" asp-route-id="@item.Id">Usuń</a>
                </td>
            </tr>
        }
    </table>
}
else
{
    <p>Brak albumów.</p>
}