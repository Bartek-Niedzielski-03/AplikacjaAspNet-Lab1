@model List<Laboratorium1.Models.Album>

<h2>Lista albumów</h2>

<a class="btn btn-success mb-3" asp-action="Create">Dodaj nowy album</a>

@if (Model.Count > 0)
{
    <table class="table">
        <tr>
            <th>@Html.DisplayNameFor(m => m[0].Title)</th>
            <th>@Html.DisplayNameFor(m => m[0].Artist)</th>
            <th>@Html.DisplayNameFor(m => m[0].MusicType)</th>
            <th>Label</th>
            <th>Akcje</th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Artist</td>
                <td>@item.MusicType.GetDisplayName()</td>
                <td>@item.LabelTitle</td>
                <td>
                    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@item.Id">Edytuj</a>
                    <a class="btn btn-info" asp-action="Details" asp-route-id="@item.Id">Szczegóły</a>
                    <a class="btn btn-danger" asp-action="Delete" asp-route-id="@item.Id">Usuń</a>
                </td>
            </tr>
        }
    </table>
    @if ((int)ViewBag.TotalPages > 1)
    {
        <nav>
            <ul class="pagination">
                @{
                    int page = (int)ViewBag.Page;
                    int totalPages = (int)ViewBag.TotalPages;
                    int pageSize = (int)ViewBag.PageSize;
                }

                <li class="page-item @(page == 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(page - 1)"
                       asp-route-pageSize="@pageSize">«</a>
                </li>

                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == page ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@p"
                           asp-route-pageSize="@pageSize">@p</a>
                    </li>
                }

                <li class="page-item @(page == totalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(page + 1)"
                       asp-route-pageSize="@pageSize">»</a>
                </li>
            </ul>
        </nav>
    }

}
else
{
    <p>Brak albumów.</p>
}