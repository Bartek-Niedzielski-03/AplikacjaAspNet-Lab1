@model Laboratorium1.Models.Album

<h2>Szczegóły albumu</h2>

<p><b>Tytuł:</b> @Model.Title</p>
<p><b>Wykonawca:</b> @Model.Artist</p>
<p><b>Pozycja:</b> @Model.Position</p>
<p><b>Data wydania:</b> @Model.ReleaseDate</p>
<p><b>Czas trwania:</b> @Model.Duration</p>

<a class="btn btn-secondary" asp-action="Index">Powrót</a>